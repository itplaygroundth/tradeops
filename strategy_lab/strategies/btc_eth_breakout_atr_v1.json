{
  "name": "btc_eth_breakout_atr_v1",
  "version": 1,
  "market": "crypto",
  "symbols": ["BTCUSDT", "ETHUSDT"],
  "timeframes": {
    "entry": "M15",
    "confirm": "H1",
    "regime": "H4"
  },
  "type": "breakout",
  "entry_rules": [
    {
      "action": "LONG",
      "when": "close_breaks_lookback_resistance_with_atr_filter"
    }
  ],
  "exit_rules": [
    {
      "action": "HOLD",
      "when": "fast_sma_below_slow_sma_or_max_hold_bars"
    }
  ],
  "risk_rules": {
    "risk_pct": 0.005,
    "max_positions": 1
  },
  "parameters": {
    "fast_sma": 9,
    "slow_sma": 21,
    "breakout_lookback": 20,
    "atr_period": 14,
    "min_atr_pct": 0.05,
    "max_atr_pct": 2.5,
    "max_entry_rsi": 78,
    "max_hold_bars": 12,
    "fee_bps": 10,
    "slippage_bps": 2
  },
  "status": "draft"
}
