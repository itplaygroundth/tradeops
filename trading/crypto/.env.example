# Exchange selection
EXCHANGE=binance          # binance | bybit
MODE=paper                # paper | live

# Binance API (only needed for live mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (only needed for live mode)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# LLM proxy for sentiment signals
BCPROXY_URL=http://192.168.1.166:3333/v1/chat/completions

# Dashboard
DASHBOARD_PORT=3006
