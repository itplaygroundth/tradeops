# Exchange selection
EXCHANGE=binance          # binance | bybit
MODE=paper                # paper | live

# Binance API (only needed for live mode)
# Binance Spot Testnet credentials. Never reuse production keys here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance Spot production credentials. Keep separate from Testnet.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Bybit API (only needed for live mode)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# LLM proxy for sentiment signals
BCPROXY_URL=http://192.168.1.166:3333/v1/chat/completions

# Dashboard
DASHBOARD_PORT=3006
